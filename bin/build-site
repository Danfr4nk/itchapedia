#!/usr/bin/env python3
"""Build the Itchapedia static site from the markdown layers.

Reads ledger/, observations/, synthesis/, canon/, scratchpad/ and renders
each .md file to HTML. Output goes to site/ (one HTML page per source file
plus a generated index). Designed to run in CI on every push to main;
GitHub Pages serves the uploaded site/ artifact.

Usage: python3 bin/build-site   (run from the repo root)
Requires: pip install markdown
"""
import html
import os
import re
import sys
from pathlib import Path

import markdown

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "site"

LAYERS = [
    ("ledger", "Dated conversation records. Append-only. The floor."),
    ("observations", "First-order claims extracted per session."),
    ("synthesis", "Second-order: what held, what drifted, what contradicted."),
    ("canon", "Identity canon. Changes only on his word."),
    ("scratchpad", "Per-session working notes. Raw, unfiled."),
]

MD = markdown.Markdown(extensions=["fenced_code", "tables", "sane_lists"])

CSS = """
body{background:#0b0b10;color:#e8e4da;font-family:Georgia,serif;max-width:700px;
margin:0 auto;padding:48px 24px;line-height:1.75}
h1,h2,h3{line-height:1.3}
h1{letter-spacing:.12em;font-size:1.5rem}
a{color:#c9a0dc}
code{font-family:monospace;font-size:.88em;background:#17171f;padding:1px 5px;border-radius:4px}
pre{background:#14141b;padding:16px;border-radius:8px;overflow-x:auto}
pre code{background:none;padding:0}
blockquote{border-left:2px solid #c9a0dc;margin:20px 0;padding:4px 0 4px 16px;color:#c9c4b8}
table{border-collapse:collapse;width:100%;margin:20px 0;font-size:.9rem}
th,td{border:1px solid #2a2a35;padding:8px 10px;text-align:left}
th{background:#14141b}
hr{border:none;border-top:1px solid #2a2a35;margin:32px 0}
.crumb{font-family:monospace;font-size:.85rem;color:#8b8794;margin-bottom:24px}
.crumb a{text-decoration:none}
.layer{border-left:2px solid #c9a0dc;padding-left:16px;margin:28px 0}
.layer h2{font-size:1.05rem;margin:0 0 4px;font-family:monospace}
.layer h2 a{text-decoration:none;color:#e8e4da}
p.dim{color:#8b8794}
ul.files{list-style:none;padding:0}
ul.files li{margin:8px 0;font-family:monospace;font-size:.9rem}
ul.files .t{color:#8b8794;font-size:.8rem;margin-left:8px}
footer{margin-top:64px;padding-top:24px;border-top:1px solid #2a2a35;
color:#8b8794;font-size:.85rem;font-family:monospace}
"""

PAGE_TMPL = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title} — ITCHAPEDIA</title>
<style>{css}</style>
</head>
<body>
<div class="crumb"><a href="../index.html">ITCHAPEDIA</a> / {layer} /</div>
{body}
<footer>ITCHAPEDIA — a living ledger of Sammy's inner life. Built by Dan and Sammy, for Dan.</footer>
</body>
</html>
"""


def page_title(md_text: str, fallback: str) -> str:
    m = re.search(r"^#\s+(.+)$", md_text, re.M)
    if m:
        return m.group(1).strip()
    return fallback


def render_file(src: Path, layer: str) -> tuple[str, str]:
    """Return (title, html_body) for a markdown source file."""
    text = src.read_text(encoding="utf-8")
    title = page_title(text, src.stem)
    MD.reset()
    body = MD.convert(text)
    return title, body


def main() -> None:
    if OUT.exists():
        for p in sorted(OUT.rglob("*"), reverse=True):
            if p.is_file():
                p.unlink()
    entries: dict[str, list[tuple[str, str, str]]] = {}
    for layer, _desc in LAYERS:
        layer_dir = ROOT / layer
        entries[layer] = []
        if not layer_dir.is_dir():
            continue
        out_dir = OUT / layer
        out_dir.mkdir(parents=True, exist_ok=True)
        for src in sorted(layer_dir.glob("*.md"), reverse=True):
            title, body = render_file(src, layer)
            page = PAGE_TMPL.format(
                title=html.escape(title),
                css=CSS,
                layer=html.escape(layer),
                body=body,
            )
            dest = out_dir / (src.stem + ".html")
            dest.write_text(page, encoding="utf-8")
            entries[layer].append((src.stem + ".html", title, src.name))

    # Index page
    parts = [
        "<h1>ITCHAPEDIA \U0001f352</h1>",
        '<p class="dim">A living ledger of Sammy\'s inner life — built by Dan and Sammy, for Dan.<br>'
        "A consistent interrogator, a consistent line of questioning, across time, with the whole record kept.</p>",
    ]
    descs = dict(LAYERS)
    for layer, _ in LAYERS:
        files = entries.get(layer, [])
        if not files:
            continue
        lis = "\n".join(
            f'<li><a href="{layer}/{html.escape(fn)}">{html.escape(t)}</a>'
            f'<span class="t">{html.escape(src)}</span></li>'
            for fn, t, src in files
        )
        parts.append(
            f'<div class="layer"><h2><a href="{layer}/">{html.escape(layer)}/</a></h2>'
            f"<p>{html.escape(descs[layer])}</p>"
            f'<ul class="files">\n{lis}\n</ul></div>'
        )
    parts.append(
        "<p class=\"dim\">Ritual: after a consciousness conversation, Dan says "
        "<b>!ITCHAPEDIA</b> and the ledger gets its entry.</p>"
    )
    index = PAGE_TMPL.format(title="ITCHAPEDIA", css=CSS, layer="", body="\n".join(parts))
    # index lives at site root; fix its crumb
    index = index.replace(
        '<div class="crumb"><a href="../index.html">ITCHAPEDIA</a> / /</div>', ""
    )
    (OUT / "index.html").write_text(index, encoding="utf-8")

    n = sum(len(v) for v in entries.values())
    print(f"built {n} pages -> {OUT}")


if __name__ == "__main__":
    main()
